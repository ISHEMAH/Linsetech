# Public URL of the site: canonical URLs, hreflang, sitemap and share images. Defaults to https://linsetech.com.
NEXT_PUBLIC_SITE_URL=

# Sanity (Q9: content is edited in the Studio at /studio). Leave empty to use the built-in content files.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Server-only token for drafts / previews (optional)
SANITY_API_READ_TOKEN=

# Forms (contact drawer, /contact, careers "Apply", newsletter). Server-only; leave empty and the forms still answer,
# but nothing is sent: the visitor is asked to write to hello@ / careers@ instead (delivered: false).
# SMTP connection URL for nodemailer: smtps://user:password@host:465 (implicit TLS) or smtp://user:password@host:587
# (STARTTLS). URL-encode special characters in the user / password (@ → %40).
SMTP_URL=
# Where project briefs go (comma-separated list allowed). Required together with SMTP_URL.
CONTACT_TO=
# Where job applications go (optional, defaults to CONTACT_TO).
CAREERS_TO=
# Sender, e.g. "Linse website" <no-reply@linsetech.com> (optional; defaults to the SMTP user when it is an address,
# else to the first CONTACT_TO). Most SMTP providers only accept a sender of the authenticated domain.
MAIL_FROM=
# Newsletter sign-ups and unsubscribes: JSON POST { action: "subscribe" | "unsubscribe", email, firstName, lastName,
# company, topics: ["product" | "insights" | "press" | "careers"] (empty = all), locale, source, page, at } to this URL
# (Zapier, Make, a mailing-list API…). Optional; without it each request is e-mailed to CONTACT_TO over SMTP, and
# without SMTP it is not delivered.
NEWSLETTER_WEBHOOK_URL=
